# Secrets
config/settings.yaml
config/google_credentials.json
config/google_token.json
config/*.json
config/*.yaml

# Keep the config directory but not secrets
!config/.gitkeep

# Voice profiles (personal data)
config/voice_profiles/

# Listening history (personal data — never commit)
config/listening_history.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.egg

# Piper TTS models (large binary files)
pi/tts/models/

# Large binary model files
pi/stt/models/
pi/llm/models/
pi/wake_word/models/
archive/server/stt/models/

# Tool request JSON files (contain user queries — pushed to GitHub manually by Pi)
tool_requests/pending/*.json
!tool_requests/pending/.gitkeep
tool_requests/complete/*.json
!tool_requests/complete/.gitkeep

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
